### Hello Developer! Copy this file to `.env` (same folder) and fill in every value.
### Running with Docker Compose? `docker compose up -d --build` is all you need afterwards.

# 1. Postgres Configuration (used to create the database container)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 2. Pg Admin Configuration (login for http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# 3. Connection String for the API — ONLY used when running the API outside Docker (dotnet run / Rider)
# Docker Compose builds its own from the POSTGRES_* values above.
# Example: Host=localhost;Port=5432;Database=kombinado_db;Username=postgres;Password=postgres;
CONNECTION_STRING=

# 4. JWT Configuration (JWT_SECRET must have at least 32 characters)
JWT_SECRET=
JWT_EXPIRE_MINUTES=
JWT_REFRESH_EXPIRE_DAYS=
JWT_ISSUER=
JWT_AUDIENCE=
